{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KryptoPilot",
  "version": "0.1.0",
  "identifier": "de.kryptopilot.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "KryptoPilot",
        "width": 390,
        "height": 844,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {
    "sql": {},
    "notification": {},
    "http": {
      "dangerousUseHttpScheme": false
    }
  }
}
